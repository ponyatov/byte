%%{
    machine dec;

    digits := |*
        digit => { res = res * 10 + (fc - '0'); };
    *|;

    main := |*
        '+'   => { sign = +1; };
        '-'   => { sign = -1; };
        digit => { res = fc - '0'; fcall digits; };
    *|;
}%%

%% write data;

int dec(char *ts, char *te) {
    char *p = ts, *pe = te, *eof = pe; int act,cs = dec_start;
    int sign = 1; int res = 0;
    %% write init;
    %% write exec;
    return sign * res;
}
