#include "byte.hpp"

%%{
    machine dec;

    main := |*
        '+'   => { sign = +1; };
        '-'   => { sign = -1; };
        digit => { res = res * 10 + (fc - '0'); };
    *|;
}%%

%% write data;

Token dec(char *ts, char *te) {
    char *p = ts, *pe = te, *eof = pe; int act,cs = dec_start;
    int sign = 1; int res = 0;
    %% write init;
    %% write exec;
    return {n:sign * res};
}
