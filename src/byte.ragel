#include "byte.hpp"

%%{
    machine lexer;

    action skip  {}
    action eol   { yyline++; yycol=1; }
    action abort {
        fprintf(stderr,"\n%s:%d:%d lexer:%c\n",yyfile,yyline,yycol,fc);
        exit(-1);
    }

    shebang      = '#!' [^\n]*;
    line_comment = '//' [^\n]*;

    num = [0-9]+;
    
    main := |*
        '\n'         => {yyline++;};
        shebang      => skip;
        line_comment => skip;
        num          => { parser(yyp, NUM, dec(ts,te)); };
        '+'          => { parser(yyp, ADD, 0         ); };
        '-'          => { parser(yyp, SUB, 0         ); };
        '*'          => { parser(yyp, MUL, 0         ); };
        '/'          => { parser(yyp, DIV, 0         ); };
        space        => skip;
        any          => abort;
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;

    void *yyp = parserAlloc(malloc);
    yyline = 1; yycol = 1;

    %% write init;
    %% write exec;
    
    parser(yyp, 0, 0);
    parserFree(yyp, free);
}

char *yyfile = nullptr;;
size_t yyline = 1;
size_t yycol  = 1;
