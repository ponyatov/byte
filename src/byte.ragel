#include "byte.hpp"

%%{
    machine lexer;

    action eol { yyline++; yycol=1; }
    action abort {
        fprintf(stderr,"\n%s:%d:%d lexer:%c\n",yyfile,yyline,yycol,fc);
        exit(-1);
    }

    shebang      = '#!' [^\n]* '\n';
    line_comment = '//' [^\n]* '\n';

    block_comment := |*
        '\n' => eol;
        '*/' => { yycol+=2; fgoto main; };
        any  => { yycol++ ;             };
    *|;

    num = [0-9]+;
    
    main := |*
        '\n'         => eol;
        shebang      => { yycol += te-ts+2; };
        line_comment => { yycol += te-ts+2; };
        '/*'         => { yycol+=2; fgoto block_comment; };
        '.end'       => { fbreak; };
        num          => { parser(yyp, NUM  , dec(ts,te)); yycol += te-ts; };
        '+'          => { parser(yyp, ADD  , {n:0}         ); yycol++;        };
        '-'          => { parser(yyp, SUB  , {n:0}         ); yycol++;        };
        '*'          => { parser(yyp, MUL  , {n:0}         ); yycol++;        };
        '/'          => { parser(yyp, DIV  , {n:0}         ); yycol++;        };
        '('          => { parser(yyp, LP   , {n:0}         ); yycol++;        };
        ')'          => { parser(yyp, RP   , {n:0}         ); yycol++;        };
        ':'          => { parser(yyp, COLON, {n:0}         ); yycol++;        };
        space        => { yycol++; };
        any          => abort;
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;

    void *yyp = parserAlloc(malloc);
    yyline = 1; yycol = 1;

    %% write init;
    %% write exec;
    
    parser(yyp, 0, {n:0});
    parserFree(yyp, free);
}

char *yyfile = nullptr;;
size_t yyline = 1;
size_t yycol  = 1;
