#include "byte.hpp"

%%{
    machine lexer;
    
    action emit_num { 
        char num[0x10];
        int len = te-ts;
        memcpy(num, ts, len);
        num[len] = 0;
        Parse(parser, NUMBER, atoi(num), 0);
    }

    action emit_add { Parse(parser, ADD, 0, 0); }
    action emit_sub { Parse(parser, SUB, 0, 0); }
    action emit_mul { Parse(parser, MUL, 0, 0); }
    action emit_div { Parse(parser, DIV, 0, 0); }
    
    num = [0-9]+;
    
    main := |*
        '\n'   => {yyline++;};
        num    => emit_num;
        '+'    => emit_add;
        '-'    => emit_sub;
        '*'    => emit_mul;
        '/'    => emit_div;
        space  => {/* drop spaces */};
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;
    
    %% write init;
    %% write exec;
    
    Parse(parser, 0, 0, 0);
}
