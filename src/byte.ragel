#include "byte.hpp"

std::string* str(char *ts,char *te) {
    return new std::string(ts,te);
}

%%{
    machine lexer;

    action eol { yyline++; yycol=1; }
    action abort {
        fprintf(stderr,"\n%s:%d:%d lexer:%c\n",yyfile,yyline,yycol,fc);
        exit(-1);
    }

    shebang      = '#!' [^\n]* '\n';
    line_comment = '//' [^\n]* '\n';

    block_comment := |*
        '\n' => eol;
        '*/' => { yycol+=2; fgoto main; };
        any  => { yycol++ ;             };
    *|;

    num = [0-9]+;

    id  = [a-z_][a-z_0-9]*;
    
    main := |*
        '\n'         => eol;
        shebang      => eol;
        line_comment => eol;
        '/*'         => { yycol+=2; fgoto block_comment; };
        '.end'       => { fbreak; };
        num          => { parser(yyp, NUM  , {n:dec(ts,te)}); yycol += te-ts; };
        '+'          => { parser(yyp, ADD  , {t:ADD}         ); yycol++;        };
        '-'          => { parser(yyp, SUB  , {t:SUB}         ); yycol++;        };
        '*'          => { parser(yyp, MUL  , {t:MUL}         ); yycol++;        };
        '/'          => { parser(yyp, DIV  , {t:DIV}         ); yycol++;        };
        '('          => { parser(yyp, LP   , {t:LP }         ); yycol++;        };
        ')'          => { parser(yyp, RP   , {t:RP }         ); yycol++;        };
        ':'          => { parser(yyp, COLON, {t:COLON}       ); yycol++;        };
        id           => { parser(yyp, ID   , {s:str(ts,te)}  ); yycol += te-ts; };
        space        => { yycol++; };
        any          => abort;
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;

    void *yyp = parserAlloc(malloc);
    yyline = 1; yycol = 1;

    %% write init;
    %% write exec;
    
    parser(yyp, 0, {t:0});
    parserFree(yyp, free);
}

char *yyfile = nullptr;;
size_t yyline = 1;
size_t yycol  = 1;
