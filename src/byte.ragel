#include "byte.hpp"

%%{
    machine lexer;
    
    action emit_num { parse(yyp, NUM, dec(ts,te), 0); }
    action emit_add { parse(yyp, ADD, 0         , 0); }
    action emit_sub { parse(yyp, SUB, 0         , 0); }
    action emit_mul { parse(yyp, MUL, 0         , 0); }
    action emit_div { parse(yyp, DIV, 0         , 0); }
    
    num = [0-9]+;
    
    main := |*
        '\n'   => {yyline++;};
        num    => emit_num;
        '+'    => emit_add;
        '-'    => emit_sub;
        '*'    => emit_mul;
        '/'    => emit_div;
        space  => {/* drop spaces */};
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;

    void *yyp = ParseAlloc(malloc);

    %% write init;
    %% write exec;
    
    parser(yyp, 0, 0, 0);
    parserFree(yyp, free);
}
