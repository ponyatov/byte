#include "byte.hpp"

%%{
    machine lexer;

    action abort {
        fprintf(stderr,"\n%s:%d:%d lexer:%c\n",yyfile,yyline,yycol,fc);
        exit(-1);
    }

    shebang      = '#!' [^\n]* '\n';
    line_comment = '//' [^\n]* '\n';

    block_comment := |*
        '\n' => { yyline++; yycol=1;    };
        '*/' => { yycol+=2; fgoto main; };
        any  => { yycol++ ;             };
    *|;

    num = [0-9]+;
    
    main := |*
        '\n'         => { yyline++; yycol=1;   parser(yyp, EOL, 0); };
        shebang      => { yycol += te-ts+2;                         };
        line_comment => { yycol += te-ts+2;                         };
        '/*'         => { yycol+=2; fgoto block_comment; };
        '.end'       => { fbreak; };
        num          => { parser(yyp, NUM, dec(ts,te)); yycol += te-ts; };
        '+'          => { parser(yyp, ADD, 0         ); yycol++;        };
        '-'          => { parser(yyp, SUB, 0         ); yycol++;        };
        '*'          => { parser(yyp, MUL, 0         ); yycol++;        };
        '/'          => { parser(yyp, DIV, 0         ); yycol++;        };
        '('          => { parser(yyp, LP , 0         ); yycol++;        };
        ')'          => { parser(yyp, RP , 0         ); yycol++;        };
        space        => { yycol++; };
        any          => abort;
    *|;
}%%

%% write data;

void lexer(char *p, char *pe) {
    char *eof = pe;
    char *ts, *te;
    int cs, act;

    void *yyp = parserAlloc(malloc);
    yyline = 1; yycol = 1;

    %% write init;
    %% write exec;
    
    parser(yyp, EOL, 0);
    parser(yyp, END, 0);
    parser(yyp, 0, 0);
    parserFree(yyp, free);
}

char *yyfile = nullptr;;
size_t yyline = 1;
size_t yycol  = 1;
