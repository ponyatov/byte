%name parser

%include { #include "byte.hpp" }

%token_type {Token}

%left ADD SUB.
%left MUL DIV.


grammar ::= stmts.

stmts ::= stmts stmt.
stmts ::= stmt.

stmt ::= expr(A) . { C(Op::lit); C(A.n); }
// stmt ::= EOL. { printf("---eol---\n"); }
// stmt ::= END. { printf("---end---\n"); }

expr(A) ::= LP expr(B) RP.       { A.n = B.n      ; }
expr(A) ::= expr(B) ADD expr(C). { A.n = B.n + C.n; }
expr(A) ::= expr(B) SUB expr(C). { A.n = B.n - C.n; }
expr(A) ::= expr(B) MUL expr(C). { A.n = B.n * C.n; }
expr(A) ::= expr(B) DIV expr(C). { A.n = B.n / C.n; }
expr(A) ::= NUM(B).              { A.n = B.n      ; }

stmt ::= COLON ID(S). { printf("label[%s] = %.4X\n",S.s->c_str(),Cp); }

%parse_accept {
    dump();
}

%syntax_error {
    printf("\n\n%s:%d:%d syntax error!\n",yyfile,yyline,yycol); exit(-1);
}
