%token_type {char*}

%left ADD SUB.
%left MUL DIV.

%start_symbol program

program ::= expr(A). { printf("Result: %s\n", A); }

expr(A) ::= expr(B) ADD expr(C). { A = "add"; }
expr(A) ::= expr(B) SUB expr(C). { A = "sub"; }
expr(A) ::= expr(B) MUL expr(C). { A = "mul"; }
expr(A) ::= expr(B) DIV expr(C). { A = "div"; }
expr(A) ::= NUM(B). { A = B; }
