%token_type {char*}

%left ADD SUB.
%left MUL DIV.

%start_symbol program

program ::= expr(A). { printf("Result: %s\n", A); }

expr(A) ::= expr(B) PLUS expr(C). { A = "add"; }
expr(A) ::= expr(B) MINUS expr(C). { A = "sub"; }
expr(A) ::= expr(B) TIMES expr(C). { A = "mul"; }
expr(A) ::= expr(B) DIVIDE expr(C). { A = "div"; }
expr(A) ::= NUMBER(B). { A = B; }

