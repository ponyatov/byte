%name parser

%include { #include "byte.hpp" }

%token_type {int}

%left ADD SUB.
%left MUL DIV.

%start_symbol grammar

grammar ::= expr(A). { printf("=%d\n", A); }

expr ::= expr(B) ADD expr(C). { $$ = B + C; }
expr ::= expr(B) SUB expr(C). { $$ = B - C; }
expr ::= expr(B) MUL expr(C). { $$ = B * C; }
expr ::= expr(B) DIV expr(C). { $$ = B / C; }
expr ::= NUM(B).              { $$ = B;     }
