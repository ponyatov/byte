%name parser

%include { #include "byte.hpp" }

%token_type {int}

%left ADD SUB.
%left MUL DIV.

%start_symbol grammar

grammar ::= expr(A) EOL. { printf("=%d\n", A); }

expr(A) ::= expr(B) ADD expr(C). { A = B + C; }
expr(A) ::= expr(B) SUB expr(C). { A = B - C; }
expr(A) ::= expr(B) MUL expr(C). { A = B * C; }
expr(A) ::= expr(B) DIV expr(C). { A = B / C; }
expr(A) ::= NUM(B).              { A = B;     }

%parse_accept {
    printf("parsing complete!\n");
}

%syntax_error {
    printf("\n\n%s:%d:%d syntax error!\n",yyfile,yyline,yycol); exit(-1);
}
